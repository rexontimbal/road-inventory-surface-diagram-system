# Copy this file to backend/.env and fill in real values for local dev.
# In Render, set these as actual environment variables instead (not a file).

# PostgreSQL connection string (Neon, Supabase, or any Postgres host).
# Leave unset to use the local SQLite file at backend/data/road_inventory.db.
DATABASE_URL=

# Google OAuth Client ID (Web application type). Must match the frontend's
# VITE_GOOGLE_CLIENT_ID -- see frontend/.env.example.
GOOGLE_CLIENT_ID=

# Secret used to sign session cookies (JWT). Any long random string, e.g.
# generate one with: python -c "import secrets; print(secrets.token_hex(32))"
# REQUIRED in production -- if unset, a random one is generated per process
# and every restart logs everyone out.
SESSION_SECRET=

# Minutes of inactivity before a guest's roads/history are auto-deleted.
# Set to 1 for local testing so you don't have to wait 15 minutes.
GUEST_DATA_TTL_MINUTES=15

# How often (minutes) the background job checks for expired guest data.
# Set to 1 for local testing.
GUEST_CLEANUP_INTERVAL_MINUTES=5

# One-time data migration: reassigns pre-accounts shared data (everything
# uploaded before per-user workspaces existed, owner_type='workspace') to
# this Google account's email, as that account's own private workspace.
# Leave unset to skip -- no effect until both this is set AND that account
# has signed in at least once. Idempotent and safe to leave set permanently
# (a no-op once there's no workspace data left to move). Case-insensitive.
LEGACY_DATA_OWNER_EMAIL=
